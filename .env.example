# ─── JWT (shared secret across all services) ───────────────────────────────
JWT_SECRET_KEY=change-me-use-a-random-secret-with-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=mipoint-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
INTERNAL_API_KEY=change-me-random-internal-service-key

# ─── PostgreSQL (local Docker) ──────────────────────────────────────────────
POSTGRES_USER=mipoint
POSTGRES_PASSWORD=change-me-postgres-password

CUSTOMER_DATABASE_URL=postgresql+asyncpg://mipoint:mipoint_secret@postgres:5432/customers_db
CATALOG_DATABASE_URL=postgresql+asyncpg://mipoint:mipoint_secret@postgres:5432/catalog_db
BOOKINGS_DATABASE_URL=postgresql+asyncpg://mipoint:mipoint_secret@postgres:5432/bookings_db
NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://mipoint:mipoint_secret@postgres:5432/notifications_db

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── RabbitMQ (local Docker) ────────────────────────────────────────────────
RABBITMQ_USER=mipoint
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_URL=amqp://mipoint:change-me-rabbitmq-password@rabbitmq:5672/

# ─── Notification APIs ──────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
SPACE_NAME_CACHE_TTL_SECONDS=1800
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890

# ─── External APIs ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Production (Neon SQL + CloudAMQP + Upstash) ───────────────────────────
# CUSTOMER_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/customers_db?sslmode=require
# CATALOG_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/catalog_db?sslmode=require
# BOOKINGS_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/bookings_db?sslmode=require
# NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/notifications_db?sslmode=require
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380
# RABBITMQ_URL=amqps://mipoint:xxx@xxx.cloudamqp.com/xxx
